{
  "_comment": "Design token 系統——UI 的所有視覺常數集中在此,啟動時注入成 CSS 變數(app/main.js loadTheme → renderer applyTheme)。改這裡就換皮,不必動 CSS/JS。缺任何一鍵時 app/index.html 的 :root 有同名 fallback。",
  "color": {
    "_note": "domain.* 由 config/domains.json 指定各域色;此處是全域語意色",
    "bronze": "#CB9F7D",
    "glass": "rgba(28,22,16,.72)",
    "glassEdge": "rgba(255,255,255,.28)",
    "ink": "#F2EDE6",
    "ink2": "rgba(242,237,230,.66)",
    "ink3": "rgba(242,237,230,.42)",
    "hair": "rgba(242,237,230,.09)",
    "hot": "#F0B9A6",
    "alarm": "#FF9C8C",
    "sevGlow": {
      "1": "radial-gradient(150% 240% at -12% 50%,rgba(214,210,172,.20) 0%,rgba(205,200,160,.08) 42%,transparent 72%)",
      "2": "radial-gradient(150% 240% at -12% 50%,rgba(214,166,126,.38) 0%,rgba(205,155,118,.16) 42%,transparent 72%)",
      "3": "radial-gradient(150% 240% at -12% 50%,rgba(196,84,58,.60) 0%,rgba(180,70,48,.28) 42%,transparent 72%)"
    }
  },
  "font": {
    "_note": "五級字階,不要再新增級距",
    "xs": "10px", "sm": "11px", "md": "12px", "lg": "13px", "xl": "16px",
    "family": "\"Noto Sans TC\",\"Microsoft JhengHei\",system-ui,sans-serif"
  },
  "space": { "_note": "4px grid", "unit": 4, "rowY": "9px", "rowX": "16px", "indent": [16, 24, 32, 40] },
  "radius": { "sm": "4px", "md": "8px", "lg": "12px", "sheet": "16px" },
  "motion": {
    "easing": "cubic-bezier(.16,1,.3,1)",
    "hoverMs": 120, "stateMs": 200, "sheetMs": 320,
    "expandMs": 260, "collapseMs": 240
  },
  "orb": {
    "size": 45, "miniSize": 26, "miniGap": 34, "safeRadius": 85,
    "level": {
      "0": { "opacity": 0.30, "filter": "saturate(.65) brightness(.92)" },
      "1": { "opacity": 0.38, "filter": "none" },
      "2": { "opacity": 0.72, "filter": "saturate(1.1)" },
      "3": { "opacity": 0.95, "filter": "saturate(1.25)", "breath": true }
    }
  },
  "window": { "width": 420, "height": 700, "anchorMargin": 12 }
}
